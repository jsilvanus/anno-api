PORT=5999
HOST=0.0.0.0
MCP_PUBLIC_URL=https://mcp.example.com
# base64-encoded random secret, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=
STORAGE_PATH=./data/app.sqlite

# Registration on the OAuth sign-in page: open (default) or closed
MCP_REGISTRATION=open
# Optional comma-separated allowlist of e-mail domains that may register, e.g. evl.fi
MCP_REGISTRATION_EMAIL_DOMAINS=
MCP_MIN_PASSWORD_LENGTH=10

# Optional bootstrap account created on first start
MCP_DEFAULT_USER_EMAIL=
MCP_DEFAULT_USER_PASSWORD=
MCP_DEFAULT_USER_ID=admin

# Behind a reverse proxy: its address (or true) so rate limiting sees client IPs
TRUST_PROXY=

# Optional single sign-on with an OpenID Connect provider (e.g. authentik). Empty OIDC_ISSUER = off:
# no button on the sign-in page and no /oidc routes. Redirect URI to register at the provider:
# <MCP_PUBLIC_URL>/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Set for a confidential client (client_secret_basic); empty = public client. PKCE is always used.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=Kirjaudu kertakirjautumisella
# true = create an account for a provider user who has none (the provider's policy decides who may sign in)
OIDC_CREATE_USERS=false
# true = link to an existing account by e-mail even when the provider does not mark it verified
OIDC_TRUST_EMAIL=false
