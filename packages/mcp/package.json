{
  "name": "@anno-api/mcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kirkkovuosi MCP server — church year of the Evangelical-Lutheran Church of Finland for MCP clients (Streamable HTTP, embedded OAuth)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=../../.env --import tsx watch src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "user": "node --env-file=../../.env --import tsx scripts/mcp-user.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anno-api/core": "2.0.0",
    "@fastify/formbody": "^8.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
